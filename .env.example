# Required
RELAY_API_TOKEN=change-me-to-a-long-random-string     # Bearer token for the REST API and /mcp
RELAY_ENCRYPTION_KEY=change-me-too                    # encrypts account credentials in the DB. Never change it afterwards.

# Public URL of this instance (needed by Instagram, which downloads media from Relay)
RELAY_BASE_URL=https://relay.example.com

# Optional
RELAY_ADDR=:8080
RELAY_DATA_DIR=/data
RELAY_TICK=30s                 # how often due posts are checked
RELAY_COLLECT_INTERVAL=6h      # how often metrics and comments are refreshed (0s = off)
RELAY_WEBHOOK_URL=             # receives post.published, post.failed, comment.new...
RELAY_WEBHOOK_SECRET=          # HMAC-SHA256 signature in X-Relay-Signature
RELAY_AGENT_INSTRUCTIONS=      # extra text for MCP agents, e.g. "The owner lives in Europe/Paris and writes tweets in English."

# X account connected automatically on first start (OAuth 1.0a user context)
X_CONSUMER_KEY=
X_CONSUMER_SECRET=        # X_SECRET_KEY is accepted as an alias
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=
